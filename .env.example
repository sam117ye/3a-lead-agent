# Copy this file to .env and fill in your keys. Never share or commit .env.

# Exa Agent: stages 1, 2 and 6 (web research)
EXA_API_KEY=

# OpenAI: the LLM (when LLM_PROVIDER=openai) and the text similarity used for ranking
OPENAI_API_KEY=

# Which LLM normalizes leftovers, matches products, writes the profile and learns: openai or anthropic
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-6.1-sol

# Only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Only needed when Anthropic says your key "is not scoped to a workspace"
ANTHROPIC_WORKSPACE_ID=
